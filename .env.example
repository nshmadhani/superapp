Does the OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4-flash

QUICKNODE_ENDPOINT_NAME=
QUICKNODE_API_TOKEN=
# Optional per-chain overrides (else built from QuickNode name+token)
# BASE_RPC_URL=https://<name>.base-mainnet.quiknode.pro/<token>
# HYPEREVM_RPC_URL=https://<name>.hype-mainnet.quiknode.pro/<token>/evm

# Server-only — never NEXT_PUBLIC_*
LIFI_API_KEY=
LIFI_INTEGRATOR=ervo
ZERION_API_KEY=
TAVILY_API_KEY=
E2B_API_KEY=

# AES key for ephemeral agent wallet private keys (64-char hex or any passphrase)
AGENT_WALLET_ENCRYPTION_KEY=

TURNKEY_API_PUBLIC_KEY=
TURNKEY_API_PRIVATE_KEY=
TURNKEY_ORGANIZATION_ID=
NEXT_PUBLIC_TURNKEY_ORGANIZATION_ID=
NEXT_PUBLIC_TURNKEY_AUTH_PROXY_CONFIG_ID=
# Auth Proxy "Session expiration" in Turnkey Dashboard (Embedded Wallets → Configuration)
# defaults to 900s (~15m). App keep-alive extends to 7d after login; still raise the
# dashboard TTL (e.g. 604800) so cold tabs aren't forced to re-login as often.

# Supabase (hosted project for dev + test; optional local: supabase start on 5442x)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only — Dashboard → Project Settings → API → service_role
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Used by browser to broadcast Solana txs after Turnkey signAndSendTransaction
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Sentry (apps/web) — DSN is public; auth token is build-only for source maps
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ORG=16-bit-labs
SENTRY_PROJECT=ervo
# SENTRY_AUTH_TOKEN=
